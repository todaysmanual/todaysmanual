# Supabase project settings. The publishable key is preferred; the legacy anon
# key name is also supported by the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key provisioned by the Resend integration or Resend dashboard.
RESEND_API_KEY=

# Optional after verifying todaysmanual.com in Resend.
# Until then, the app uses Today's Manual <onboarding@resend.dev>.
WAITLIST_FROM_EMAIL=
